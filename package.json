{
  "name": "diretor",
  "version": "0.1.0",
  "description": "Editor de vídeo desktop com edição compartilhada com o Claude (MCP local)",
  "author": "Diretor",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env-shell DIRETOR_DEV_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "mcp:config": "node scripts/print-mcp-config.mjs",
    "dist": "npm run build && electron-builder --publish never"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teste652/Diretor.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/teste652/Diretor/issues"
  },
  "homepage": "https://github.com/teste652/Diretor#readme",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.4",
    "electron-builder": "26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "playwright-core": "1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wait-on": "^9.5.1",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "io.github.teste652.diretor",
    "productName": "Diretor",
    "executableName": "Diretor",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!**/*.map",
      "package.json"
    ],
    "asarUnpack": [
      "dist/mcp/**",
      "node_modules/ffmpeg-static/**"
    ],
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Diretor-Setup.${ext}",
      "shortcutName": "Diretor",
      "uninstallDisplayName": "Diretor",
      "differentialPackage": false
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/teste652/Diretor/releases/download/teste"
      }
    ]
  },
  "private": true
}
